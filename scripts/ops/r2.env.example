# Copied to /etc/para-backup/r2.env (root, 0600) and filled in on the server.
# Never commit the filled-in file.
#
# From the Cloudflare dashboard:
#   R2 > Overview           the Account ID
#   R2 > Manage API tokens  an "Object Read & Write" token restricted to the
#                           backup bucket: Access Key ID and Secret Access Key
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=para-backups
