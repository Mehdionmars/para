# Postgres connection string. With the bundled docker-compose.yml (port 5433
# on the host, to stay clear of other local Postgres instances):
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5433/para_dhiver

# Any long random string. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudinary (Dashboard > Settings > API Keys). Leave unset during local dev
# to fall back to local-disk storage under /media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder every upload is namespaced under in Cloudinary.
CLOUDINARY_FOLDER=para-dhiver

# Where the Next.js frontend can reach this API from (used for CORS/CSRF).
FRONTEND_URL=http://localhost:3000

# Meta Instagram Graph API (Business/Creator account connected to a Facebook
# Page). Get a long-lived access token and the IG business account id from
# https://developers.facebook.com/docs/instagram-platform/instagram-graph-api.
# Server-only — never read by any frontend/client code. Leave unset to skip
# syncing (the storefront keeps showing whatever was last synced).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Shared secret required (as `Authorization: Bearer <value>`) to call
# POST /api/instagram-sync — generate one with: openssl rand -base64 32
INSTAGRAM_SYNC_SECRET=

# Share of API traffic recorded in api-request-logs, 0 to 1. Errors and writes
# are always kept in full; only successful reads are sampled. Before sampling,
# every Payload operation wrote a row — including each product read the
# storefront makes — which doubled the write load exactly when read traffic
# peaked. Defaults to 0.05.
API_LOG_SAMPLE_RATE=0.05

# Postgres pool size PER INSTANCE. On serverless each warm instance keeps its
# own, so the driver default of 10 is 10 per instance: keep this small and put
# a transaction-mode pooler in front (PgBouncer, Supabase :6543, Neon pooled).
PGPOOL_MAX=5

# Shared secret required (as `Authorization: Bearer <value>`) to call
# POST /api/jobs/tick — the background drain that delivers queued notifications
# and applies retention. Generate one with: openssl rand -base64 32
# Without it and a cron calling it, no email is ever sent.
JOBS_SECRET=

# ---- URLs --------------------------------------------------------------
# This API's own public origin. Backs Payload's serverURL, so it is what the
# admin UI and generated links resolve against.
#   local       http://localhost:3001
#   production  https://api.paradhiver.ma
SERVER_URL=http://localhost:3001

# Origin the dashboard is served from. Joins FRONTEND_URL and SERVER_URL in
# the CORS/CSRF allow-list. The localhost pair is added automatically outside
# production, so these three must carry the real origins when NODE_ENV=production.
#   production  https://admin.paradhiver.ma
ADMIN_URL=http://localhost:3000

# Where the cache purge is sent when the storefront is not reachable at
# FRONTEND_URL from inside this container/network — the docker-compose case,
# where "localhost:3000" would resolve to this service itself. FRONTEND_URL
# stays the browser-facing origin because it backs CORS/CSRF. Unset outside
# Docker; on Render the two hosts talk over the public URL.
STOREFRONT_INTERNAL_URL=

# Shared secret for the storefront cache purge (POST <storefront>/api/revalidate).
# Must match REVALIDATE_SECRET in the frontend's environment. Generate with:
#   openssl rand -base64 32
# Unset, content edits simply wait for the storefront's own cache timers.
REVALIDATE_SECRET=

# ---- Email -------------------------------------------------------------
# Two transports, one sender address. Resend is preferred when present; the
# generic HTTP provider is the escape hatch for any other vendor. Configure
# ONE of them fully — a half-set group is refused at boot by lib/env.ts, and
# a sender with no transport is refused too (it looks configured and silently
# delivers nothing).
#
#   Resend   RESEND_API_KEY + EMAIL_FROM
#   Generic  EMAIL_API_URL + EMAIL_API_KEY + EMAIL_FROM
#
# With neither set, notifications are queued and reported as skipped rather
# than lost. Nothing is ever sent until a transport exists.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=
EMAIL_API_KEY=

# Where low-stock alerts go. Unset, the alert is skipped (orders are not
# affected).
STOCK_ALERT_EMAIL=

# ---- Runtime -----------------------------------------------------------
# Port the server binds. Render injects this itself — leave it unset there.
# Local development uses 3001 by project convention.
PORT=3001

# Schema-drift diagnostic, not a mode. PAYLOAD_DB_PUSH=1 lets Payload build
# the schema its config implies so it can be diffed against the migrations.
# Point DATABASE_URI at a scratch database first: never set this against a
# database anyone depends on.
PAYLOAD_DB_PUSH=
