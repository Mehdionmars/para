# =============================================================================
# Para d'Hiver — storefront / dashboard (Next.js)
# =============================================================================
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is readable by every visitor. Only genuinely public configuration
# belongs under that prefix — no key, token or shared secret, ever.
# =============================================================================

# ---- Server-only ------------------------------------------------------------

# Base URL of the Payload backend, used for server-side fetches and by the
# dashboard proxy. Deliberately NOT NEXT_PUBLIC_: the browser talks to this
# app's own /api routes, never to the CMS directly.
#   local       http://localhost:3001
#   production  https://api.paradhiver.ma
CMS_URL=http://localhost:3001

# Shared secret for the CMS -> storefront cache purge (POST /api/revalidate).
# Must match REVALIDATE_SECRET in backend/.env. Generate one with:
#   openssl rand -base64 32
# Unset, the route answers 503 and caches expire on their own timer.
REVALIDATE_SECRET=CHANGE_ME

# ---- Public (exposed to the browser) ----------------------------------------

# Canonical public origin. Backs metadataBase, so it is what canonical URLs,
# Open Graph tags and sitemap entries are resolved against — a wrong value
# here publishes wrong URLs to crawlers.
#   local       http://localhost:3000
#   production  https://paradhiver.ma
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary cloud name, used to build delivery URLs for assets stored as a
# bare public id. Public by design: it appears in every image URL on the site.
# Leave unset when the backend is on local-disk storage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# WhatsApp number in international format, digits only (e.g. 212600000000).
# Unset, the floating WhatsApp button is not rendered at all.
NEXT_PUBLIC_WHATSAPP_PHONE=

# ---- Tests only (not needed to run the app) ---------------------------------
# Read by tests/e2e and tests/audit. The suites that need credentials skip
# themselves when these are unset, so leave them empty outside CI.
# E2E_BASE_URL=
# E2E_DASHBOARD_BASE_URL=
# E2E_DASHBOARD_EMAIL=
# E2E_DASHBOARD_PASSWORD=
# E2E_CMS_URL=
# AUDIT_SHOP_URL=
# AUDIT_DASH_URL=
# AUDIT_EMAIL=
# AUDIT_PASSWORD=
